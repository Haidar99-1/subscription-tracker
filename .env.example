# This is an example .env file. Please do not commit any secrets or sensitive information.

PORT=5500
SERVER_URL="http://localhost:5500"

# ENVIRONMENT
NODE_ENV=development

# DATABASE
DB_URI="mongodb://<username>:<password>@<host>:<port>/<database>?authSource=admin"

# JWT AUTH
JWT_SECRET="<your_jwt_secret_here>"
JWT_EXPIRES_IN="1d"